# Copy to .env and fill in. Evidence images are stored on local disk
# (UPLOADS_DIR, default data/uploads) -- no object storage service is used.

# --- Runtime environment ---
# "development" (default) | "production". In production, refuses to start if
# METROS_AUTH_DISABLED=1 or JWT_SECRET is still the default below.
METROS_ENV=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://metrology:metrology@db:5432/metrology

# --- Auth ---
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=480

# --- ArUco scale marker ---
# Physical side length of the printed marker in millimetres. Must match
# scripts/gen_calibration_card.py's --marker-mm (default 40.0) -- a mismatch
# here makes every millimetre measurement wrong.
MARKER_SIZE_MM=40.0

# --- Label reader OCR engine ---
# "paddleocr_api" (default, this experimental branch) uses PaddleOCR's
# hosted API -- no GPU, no model download. Falls back to Tesseract
# automatically if PADDLEOCR_ACCESS_TOKEN is unset or the API fails. Set to
# "tesseract" to use Tesseract directly -- see requirements-ocr.txt.
METROS_OCR_ENGINE=paddleocr_api

# Access token for PaddleOCR's official hosted API (Baidu AI Studio). Get
# one at https://aistudio.baidu.com/account/accessToken (free account).
# Backend-only -- never sent to the frontend. Leave unset to always use
# Tesseract.
PADDLEOCR_ACCESS_TOKEN=
