# Copy to .env and fill in. Evidence images are stored on local disk
# (UPLOADS_DIR, default data/uploads) -- no object storage service is used.

# --- Runtime environment ---
# "development" (default) | "production". In production, refuses to start if
# METROS_AUTH_DISABLED=1 or JWT_SECRET is still the default below.
METROS_ENV=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://metrology:metrology@db:5432/metrology

# --- Auth ---
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=480

# --- ArUco scale marker ---
# Physical side length of the printed marker in millimetres. Must match
# scripts/gen_calibration_card.py's --marker-mm (default 40.0) -- a mismatch
# here makes every millimetre measurement wrong.
MARKER_SIZE_MM=40.0

# --- Label reader OCR engine ---
# "tesseract" (default) needs the tesseract binary on PATH -- see
# requirements-ocr.txt. A vision-based Gemini reader is being added back on
# this experimental branch (see backend/extract/gemini_reader.py).
METROS_OCR_ENGINE=tesseract
