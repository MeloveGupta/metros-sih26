# Copy to .env and fill in. The pipeline runs fully offline without any of these
# except the DB/storage/JWT settings; the LLM fast-path activates only if a key
# is present.

# --- Database ---
DATABASE_URL=postgresql+psycopg://metrology:metrology@db:5432/metrology

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scans

# --- Auth ---
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=480

# --- ArUco scale marker ---
# Physical side length of the printed marker in millimetres.
MARKER_SIZE_MM=20.0

# --- Optional LLM extraction fast-path ---
# Auth is by login, NOT an API key: run `ant auth login` once and the Anthropic
# SDK picks up the OAuth session automatically. Leave everything here unset to
# stay fully offline (regex extraction). ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY
# are honored only if you deliberately set them.
# ANTHROPIC_AUTH_TOKEN=
GEMINI_API_KEY=
