# Copy to .env and fill in. Evidence images, crops and generated reports are
# stored on local disk (UPLOADS_DIR, default data/uploads) unless the
# Supabase Storage vars below are set, in which case they go there instead
# (see backend/core/storage.py).

# --- Runtime environment ---
# "development" (default) | "production". In production, refuses to start if
# METROS_AUTH_DISABLED=1 or JWT_SECRET is still the default below.
METROS_ENV=development

# --- Database ---
# Docker Compose default shown here ("db" is a Compose service hostname --
# doesn't resolve outside Compose; comment this out for local dev to fall
# back to SQLite, see backend/core/config.py). For Supabase Postgres, use the
# connection-pooler URL from Project Settings -> Database -- note the
# "+psycopg" (SQLAlchemy's psycopg3 driver, not the bare "postgresql://" the
# dashboard shows) and that Supabase requires SSL:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://metrology:metrology@db:5432/metrology

# --- Auth ---
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=480

# --- ArUco scale marker ---
# Physical side length of the printed marker in millimetres. Must match
# scripts/gen_calibration_card.py's --marker-mm (default 40.0) -- a mismatch
# here makes every millimetre measurement wrong.
MARKER_SIZE_MM=40.0

# --- Label reader OCR engine ---
# "gemini" (default) reads declarations straight off the photos via Google
# Gemini's free tier -- needs GEMINI_API_KEY below; falls back to "tesseract"
# (needs the tesseract binary on PATH -- see requirements-ocr.txt) whenever
# the key is unset or a call fails, so a scan is never silently empty.
METROS_OCR_ENGINE=gemini

# --- Gemini (Google AI Studio, free tier) ---
# Get a key at https://aistudio.google.com/apikey. Backend only -- never
# logged or exposed to the frontend. Model IDs default to the current
# free-tier Flash-Lite (primary) and Flash (fallback on 429/quota) --
# override only if you know what you're doing (see backend/extract/
# gemini_reader.py's module docstring for how these were confirmed).
GEMINI_API_KEY=
METROS_GEMINI_MODEL=
METROS_GEMINI_FALLBACK_MODEL=

# --- Evidence + report storage: Supabase Storage (production) ---
# All three must be set to use Supabase Storage -- otherwise falls back to
# local disk (UPLOADS_DIR), which is fine for local dev but ephemeral on
# most container hosts. Create a PRIVATE bucket (no public read) in the
# Supabase dashboard -- Storage -> New bucket; files are only ever served
# back out through this API's own authenticated endpoints, never a public
# Supabase URL. Use the service_role key (Project Settings -> API), not anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- First-boot admin ---
# If set and no users exist yet, the API creates this admin at startup (see
# backend/db/repository.py's ensure_admin_user) -- there's no sign-up flow,
# so a fresh production database otherwise has no way to log in without a
# manual DB write. Safe to leave set across restarts; a no-op once any user
# exists (including one seeded locally via scripts/seed_users.py).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS (split-origin deployments, e.g. Vercel frontend + Render backend) ---
# Comma-separated origins allowed to call this API cross-origin. Empty by
# default -- fail closed, no cross-origin access at all -- so this must be
# set to the frontend's real origin(s) for a split-origin deployment, e.g.
# ALLOWED_ORIGINS=https://metros.vercel.app
ALLOWED_ORIGINS=
