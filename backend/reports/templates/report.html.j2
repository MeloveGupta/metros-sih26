<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Metros Report {{ r.ref_no or r.report_id }}</title>
<style>
  @page {
    size: A4; margin: 18mm 16mm 20mm;
    @bottom-center {
      content: "Metros - decision-support - not a final legal finding - page " counter(page) " of " counter(pages);
      font-family: Helvetica, Arial, sans-serif; font-size: 7.5pt; color: #8a8f98;
    }
  }
  * { box-sizing: border-box; }
  body { font-family: Helvetica, Arial, sans-serif; color: #16181d; font-size: 9.5pt; line-height: 1.5; margin: 0; }
  .mono { font-family: "Courier New", monospace; }

  /* Masthead */
  .mast { display: flex; align-items: flex-end; justify-content: space-between;
          border-bottom: 3px solid #16181d; padding-bottom: 8px; margin-bottom: 4px; }
  .brand { font-size: 26pt; font-weight: 800; letter-spacing: 1px; }
  .brand small { font-size: 8pt; font-weight: 600; color: #5f6772; letter-spacing: 2px; display: block; margin-top: 2px; }
  .refbox { text-align: right; font-size: 8pt; color: #5f6772; }
  .refbox b { font-size: 11pt; color: #16181d; display: block; font-family: "Courier New", monospace; }

  /* Disposition banner */
  .disp { margin: 10px 0 14px; padding: 8px 12px; border: 2px solid #16181d;
          display: flex; justify-content: space-between; align-items: center; }
  .disp .tag { font-size: 11pt; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; }
  .disp .sub { font-size: 7.5pt; color: #5f6772; max-width: 58%; text-align: right; }

  /* KPI strip */
  .kpis { display: flex; border: 1.5px solid #16181d; margin: 0 0 14px; }
  .kpi { flex: 1; padding: 8px 10px; border-right: 1.5px solid #16181d; }
  .kpi:last-child { border-right: 0; }
  .kpi .n { font-size: 16pt; font-weight: 800; font-family: "Courier New", monospace; line-height: 1; }
  .kpi .l { font-size: 6.5pt; text-transform: uppercase; letter-spacing: .5px; color: #5f6772; }

  h2.sec { font-size: 10.5pt; text-transform: uppercase; letter-spacing: .5px; margin: 16px 0 6px;
           padding-bottom: 3px; border-bottom: 1.5px solid #16181d; }
  h2.sec span { color: #12564f; font-family: "Courier New", monospace; margin-right: 6px; }

  table { border-collapse: collapse; width: 100%; margin: 4px 0; }
  th { text-align: left; font-size: 7pt; text-transform: uppercase; letter-spacing: .4px; color: #5f6772;
       border-bottom: 1.5px solid #16181d; padding: 5px 6px; }
  td { padding: 6px; border-bottom: .75pt solid #d7dbe0; vertical-align: top; }
  tr:last-child td { border-bottom: 0; }

  .pill { font-size: 6.5pt; font-weight: 800; text-transform: uppercase; letter-spacing: .3px;
          padding: 2px 6px; border: 1pt solid #16181d; white-space: nowrap; }
  .st-compliant { background: #eaf5ee; }
  .st-potential_non_compliance { background: #fbefdd; }
  .st-not_detected { background: #fbe6e8; }
  .st-not_assessable, .st-not_applicable { background: #eef0f2; color: #5f6772; }

  .muted { color: #5f6772; }
  .cal { border: 1.5px dashed #9aa0a8; padding: 8px 10px; font-size: 8.5pt; margin: 4px 0; }
  .cal b { font-family: "Courier New", monospace; }
  .note { font-size: 7.5pt; color: #5f6772; margin: 6px 0; }
  .evgrid td { border: none; padding: 2px 8px 2px 0; }
</style>
</head>
<body>

<div class="mast">
  <div class="brand">METROS<small>LEGAL METROLOGY COMPLIANCE</small></div>
  <div class="refbox">
    Report reference<b>{{ r.ref_no or r.report_id[:8] }}</b>
    {{ r.generated_at.strftime("%d %b %Y, %H:%M UTC") if r.generated_at.strftime else r.generated_at }}
  </div>
</div>

<div class="disp">
  <span class="tag">{{ r.disposition.value.replace("_", " ") }}</span>
  <span class="sub">Decision-support. Potential non-compliance flagged for officer verification.
    Not a final legal finding; physical verification required for enforcement.</span>
</div>

<div class="kpis">
  <div class="kpi"><div class="n">{{ r.summary.checked }}</div><div class="l">Checked</div></div>
  <div class="kpi"><div class="n">{{ r.summary.compliant }}</div><div class="l">Compliant</div></div>
  <div class="kpi"><div class="n">{{ r.summary.potential_non_compliance }}</div><div class="l">Potential NC</div></div>
  <div class="kpi"><div class="n">{{ r.summary.not_detected }}</div><div class="l">Not detected</div></div>
  <div class="kpi"><div class="n">{{ r.summary.not_assessable }}</div><div class="l">Not assessable</div></div>
  <div class="kpi"><div class="n">{{ "%.0f%%"|format(r.summary.overall_confidence * 100) }}</div><div class="l">Confidence</div></div>
</div>

{% if r.product.name or r.product.brand %}
<h2 class="sec"><span>·</span>Product</h2>
<table class="evgrid">
  <tr><td class="muted">Name</td><td>{{ r.product.name or "-" }}</td>
      <td class="muted">Brand</td><td>{{ r.product.brand or "-" }}</td></tr>
  <tr><td class="muted">Category</td><td>{{ r.product.category or "-" }}</td>
      <td class="muted">Source</td><td>{{ r.product.source or "-" }}</td></tr>
</table>
{% endif %}

<h2 class="sec"><span>01</span>Declarations · Rule 6</h2>
<table>
  <thead><tr><th style="width:34%">Declaration</th><th style="width:14%">Clause</th>
    <th style="width:33%">Extracted</th><th style="width:19%">Status</th></tr></thead>
  <tbody>
  {% for d in r.declarations %}
    <tr>
      <td>{{ d.label }}</td>
      <td class="mono">{{ d.clause_ref.clause }}</td>
      <td class="muted">{{ d.extracted or "not found on pack" }}</td>
      <td><span class="pill st-{{ d.status.value }}">{{ d.status.value.replace("_", " ") }}</span></td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2 class="sec"><span>02</span>Letter height · Rule 7</h2>
<div class="cal">
  <b>Calibration:</b> {{ r.calibration.verdict.value.replace("_", " ") }}
  {% if r.calibration.mm_per_pixel %} · <b>{{ "%.5f"|format(r.calibration.mm_per_pixel) }} mm/px</b>{% endif %}
  {% if r.calibration.reason %} · <span class="muted">{{ r.calibration.reason }}</span>{% endif %}
</div>
{% if r.font_analysis.panel_area_cm2 and r.font_analysis.table_i_band %}
<p class="note">Principal display panel area
  <b>{{ "%.1f ± %.1f"|format(r.font_analysis.panel_area_cm2.value, r.font_analysis.panel_area_cm2.uncertainty) }} cm²</b>
  → Table-I band <b>{{ r.font_analysis.table_i_band.area_band }}</b>,
  minimum letter height <b>{{ r.font_analysis.table_i_band.min_height_mm }} mm</b>.</p>
{% endif %}
{% if r.font_analysis.items %}
<table>
  <thead><tr><th>Label text</th><th>Measured height</th><th>Threshold</th><th>Status</th><th>Reason</th></tr></thead>
  <tbody>
  {% for i in r.font_analysis.items %}
    <tr>
      <td>{{ i.declaration_id }}</td>
      <td class="mono">{% if i.height_mm %}{{ "%.2f ± %.2f mm"|format(i.height_mm.value, i.height_mm.uncertainty) }}{% else %}-{% endif %}</td>
      <td class="mono">{{ "%.1f mm"|format(i.threshold_mm) if i.threshold_mm is not none else "-" }}</td>
      <td><span class="pill st-{{ i.status.value }}">{{ i.status.value.replace("_", " ") }}</span></td>
      <td class="muted">{{ i.reason or "" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="note">No letter-height measurement (no Metros card in frame, or uncalibrated).</p>
{% endif %}

{% if r.officer_actions %}
<h2 class="sec"><span>03</span>Officer verification</h2>
<table>
  <thead><tr><th style="width:34%">Item</th><th style="width:20%">Decision</th>
    <th style="width:46%">Officer note</th></tr></thead>
  <tbody>
  {% for a in r.officer_actions %}
    <tr>
      <td>{{ a.declaration_id }}</td>
      <td><span class="pill st-{{ 'compliant' if a.action == 'verified_compliant' else 'potential_non_compliance' }}">
        {{ "verified compliant" if a.action == "verified_compliant" else "issue confirmed" }}</span></td>
      <td class="muted">{{ a.reason or "-" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="note">Finalized by <b>{{ r.finalized_by or "-" }}</b>
  {% if r.finalized_at %}on {{ r.finalized_at.strftime("%d %b %Y, %H:%M UTC") if r.finalized_at.strftime else r.finalized_at }}{% endif %}.</p>
{% elif r.summary.required_actions %}
<h2 class="sec"><span>03</span>Officer actions required</h2>
<table>
  <tbody>
  {% for a in r.summary.required_actions %}
    <tr><td>{{ a }}</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="note">Not yet verified by an officer.</p>
{% endif %}

<h2 class="sec"><span>04</span>Evidence &amp; legal basis</h2>
<table class="evgrid">
  <tr><td class="muted">Original file</td><td>{{ r.evidence.original.file }}</td></tr>
  <tr><td class="muted">Resolution</td><td>{{ r.evidence.original.width }} × {{ r.evidence.original.height }} px</td></tr>
  <tr><td class="muted">SHA-256</td><td class="mono" style="font-size:7pt;word-break:break-all">{{ r.evidence.original.sha256 }}</td></tr>
  {% if r.legal_basis.statute %}<tr><td class="muted">Statute</td><td>{{ r.legal_basis.statute }}</td></tr>{% endif %}
  <tr><td class="muted">Rule catalog</td><td>{{ r.rule_catalog.version }}</td></tr>
</table>
<p class="note">{{ r.evidence.integrity_note }}</p>
<p class="note">{{ r.limitations }}</p>

</body>
</html>
