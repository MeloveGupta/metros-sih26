<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>MetroScan Report {{ r.ref_no or r.report_id }}</title>
<style>
  :root { --ok:#137333; --flag:#b06000; --miss:#8a1c1c; --na:#5f6368; --ink:#202124; }
  * { box-sizing: border-box; }
  body { font: 12px/1.5 system-ui, Arial, sans-serif; color: var(--ink); margin: 24px; }
  h1 { font-size: 20px; margin: 0 0 2px; }
  h2 { font-size: 14px; border-bottom: 2px solid #ddd; padding-bottom: 3px; margin: 20px 0 8px; }
  .banner { background: #fff4e5; border: 1px solid #e0a458; padding: 8px 10px; border-radius: 6px; margin: 10px 0; }
  .watermark { color: #b06000; font-weight: 700; }
  table { border-collapse: collapse; width: 100%; margin: 6px 0; }
  th, td { border: 1px solid #ddd; padding: 5px 7px; text-align: left; vertical-align: top; }
  th { background: #f1f3f4; }
  .s-compliant { color: var(--ok); font-weight: 600; }
  .s-potential_non_compliance { color: var(--flag); font-weight: 600; }
  .s-not_detected { color: var(--miss); font-weight: 600; }
  .s-not_assessable, .s-not_applicable { color: var(--na); }
  .muted { color: #5f6368; }
  .kpi { display: inline-block; margin-right: 14px; }
  .kpi b { font-size: 16px; }
  code { background: #f1f3f4; padding: 0 3px; border-radius: 3px; }
</style>
</head>
<body>

<h1>MetroScan — Packaged Commodity Compliance Report</h1>
<div class="muted">Ref {{ r.ref_no or r.report_id }} · generated {{ r.generated_at }} · app v{{ r.app_version }}
 · catalog {{ r.rule_catalog.version }}</div>

<div class="banner">
  <span class="watermark">DECISION-SUPPORT — potential non-compliance flagged for officer verification.</span>
  Not a final legal finding. Physical verification required for enforcement.
</div>

<h2>1. Inspection & product</h2>
<table>
  <tr><th>Officer</th><td>{{ r.inspection.officer.name if r.inspection.officer else "—" }}
      {% if r.inspection.officer %}({{ r.inspection.officer.id }}, {{ r.inspection.officer.role }}){% endif %}</td>
      <th>Jurisdiction</th><td>{{ r.inspection.jurisdiction or "—" }}</td></tr>
  <tr><th>Product</th><td>{{ r.product.name or "—" }}</td>
      <th>Brand</th><td>{{ r.product.brand or "—" }}</td></tr>
  <tr><th>Category</th><td>{{ r.product.category or "—" }}</td>
      <th>Source</th><td>{{ r.product.source or "—" }}</td></tr>
</table>

<h2>2. Executive summary</h2>
<div>
  <span class="kpi">Checked <b>{{ r.summary.checked }}</b></span>
  <span class="kpi s-compliant">Compliant <b>{{ r.summary.compliant }}</b></span>
  <span class="kpi s-potential_non_compliance">Potential NC <b>{{ r.summary.potential_non_compliance }}</b></span>
  <span class="kpi s-not_detected">Not detected <b>{{ r.summary.not_detected }}</b></span>
  <span class="kpi s-not_assessable">Not assessable <b>{{ r.summary.not_assessable }}</b></span>
  <span class="kpi">Confidence <b>{{ "%.0f%%"|format(r.summary.overall_confidence * 100) }}</b></span>
</div>
{% if r.summary.required_actions %}
<p><b>Required officer actions:</b></p>
<ul>{% for a in r.summary.required_actions %}<li>{{ a }}</li>{% endfor %}</ul>
{% endif %}

<h2>3. Evidence & chain of custody</h2>
<table>
  <tr><th>Original file</th><td>{{ r.evidence.original.file }}</td></tr>
  <tr><th>SHA-256</th><td><code>{{ r.evidence.original.sha256 }}</code></td></tr>
  <tr><th>Resolution</th><td>{{ r.evidence.original.width }}×{{ r.evidence.original.height }}</td></tr>
</table>
<p class="muted">{{ r.evidence.integrity_note }}</p>

<h2>4. Calibration & measurement basis</h2>
<table>
  <tr><th>Verdict</th><td class="s-{{ 'compliant' if r.calibration.verdict.value=='calibrated' else 'not_assessable' }}">
      {{ r.calibration.verdict.value }}</td>
      <th>Reference</th><td>{{ r.calibration.reference }}
        {% if r.calibration.aruco_dict %}({{ r.calibration.aruco_dict }} id={{ r.calibration.marker_id }}){% endif %}</td></tr>
  <tr><th>Marker size</th><td>{{ r.calibration.marker_mm or "—" }} mm</td>
      <th>mm / pixel</th><td>{{ "%.5f"|format(r.calibration.mm_per_pixel) if r.calibration.mm_per_pixel else "—" }}</td></tr>
  <tr><th>Homography residual</th><td>{{ "%.2f px"|format(r.calibration.homography_residual_px) if r.calibration.homography_residual_px is not none else "—" }}</td>
      <th>Detection confidence</th><td>{{ r.calibration.detection_confidence if r.calibration.detection_confidence is not none else "—" }}</td></tr>
</table>
{% if r.calibration.verdict.value != 'calibrated' %}
<p class="s-not_assessable">Uncalibrated: {{ r.calibration.reason }} — no millimetre verdicts are reported.</p>
{% endif %}

<h2>5. Declaration findings (Rule 6)</h2>
<table>
  <tr><th>Declaration</th><th>Clause</th><th>Extracted</th><th>Format</th><th>Status</th><th>Note</th></tr>
  {% for d in r.declarations %}
  <tr>
    <td>{{ d.label }}</td>
    <td>{{ d.clause_ref.clause }}{% if d.clause_ref.gazette %}<br><span class="muted">{{ d.clause_ref.gazette }}</span>{% endif %}</td>
    <td>{{ d.extracted or "—" }}</td>
    <td>{% if d.format_check %}{{ "pass" if d.format_check.passed else "fail" }}{% else %}—{% endif %}</td>
    <td class="s-{{ d.status.value }}">{{ d.status.value }}</td>
    <td class="muted">{{ d.note or "" }}</td>
  </tr>
  {% endfor %}
</table>

<h2>6. Font-size & placement analysis (Rule 7)</h2>
{% if r.font_analysis.panel_area_cm2 %}
<p>Principal display panel area: <b>{{ "%.1f ± %.1f"|format(r.font_analysis.panel_area_cm2.value, r.font_analysis.panel_area_cm2.uncertainty) }} cm²</b>
 → band <code>{{ r.font_analysis.table_i_band.area_band }}</code>,
 minimum height <b>{{ r.font_analysis.table_i_band.min_height_mm }} mm</b>
 (molded {{ r.font_analysis.table_i_band.min_height_mm_molded }} mm).</p>
{% endif %}
{% if r.font_analysis.items %}
<table>
  <tr><th>Declaration</th><th>Measured height</th><th>Width ratio</th><th>Threshold</th><th>Status</th><th>Reason</th></tr>
  {% for i in r.font_analysis.items %}
  <tr>
    <td>{{ i.declaration_id }}</td>
    <td>{% if i.height_mm %}{{ "%.2f ± %.2f mm"|format(i.height_mm.value, i.height_mm.uncertainty) }}{% else %}—{% endif %}</td>
    <td>{{ "%.2f"|format(i.width_ratio) if i.width_ratio is not none else "—" }}</td>
    <td>{{ "%.1f mm"|format(i.threshold_mm) if i.threshold_mm is not none else "—" }}</td>
    <td class="s-{{ i.status.value }}">{{ i.status.value }}</td>
    <td class="muted">{{ i.reason or "" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}<p class="muted">No font measurements in this report.</p>{% endif %}

<h2>7. Legal basis</h2>
{% if r.legal_basis.statute %}<p><b>{{ r.legal_basis.statute }}</b></p>{% endif %}
<p class="muted">All clauses cited above reference the Legal Metrology (Packaged Commodities)
 Rules, 2011 as amended; verify against official notifications before enforcement.</p>

<h2>8. Limitations & confidence</h2>
<p class="muted">{{ r.limitations }}</p>

</body>
</html>
